class SimulatorAdapter:
    """[ADAPTER LAYER] Normalizes v3.x simulator interfaces for the observer."""

    def __init__(self, module, version_label: str):
        self.mod = module
        self.version_label = version_label

    def create_threat_generator(self, rng: random.Random, config) -> Any:
        raise NotImplementedError

    def create_core(self, config, defense_on: bool) -> Any:
        raise NotImplementedError

    def get_core_state(self, core) -> Any:
        return core.state

    def get_core_shield_state(self, core) -> Any:
        return core.shield_state

    def get_core_defense(self, core) -> Any:
        raise NotImplementedError

    def get_core_events(self, core) -> List[Any]:
        return core.events

    def get_core_telemetry(self, core) -> Dict[str, Any]:
        return core.get_telemetry()

    def set_shield_mode(self, core, mode) -> None:
        core.set_shield_mode(mode)

    def inject_threat(self, core, threat: float) -> Dict[str, Any]:
        return core.inject_threat(threat)

    def auto_recovery(self, core) -> Dict[str, Any]:
        return core.auto_recovery()

    def structural_repair(self, core) -> Dict[str, Any]:
        return core.structural_repair()

    def shield_structural_repair(self, core) -> Dict[str, Any]:
        return core.shield_structural_repair()

    def manual_reboot(self, core) -> Dict[str, Any]:
        return core.manual_reboot()

    def validate_core(self, core) -> None:
        core._validate()

    def create_metrics_collector(self) -> Any:
        raise NotImplementedError

    def record_metrics(self, metrics, tick, state, stability, shield_energy, shield_integrity, max_stability) -> None:
        metrics.record(tick, state, stability, shield_energy, shield_integrity, max_stability)

    def record_conservation(self, metrics, heat: float, structural: float, conservation_result: Dict) -> None:
        raise NotImplementedError

    def get_metrics_summary(self, metrics) -> Dict[str, Any]:
        return metrics.summarize()

    def set_breach_events(self, metrics, value: int) -> None:
        metrics.breach_events = value

    def get_breach_events(self, metrics) -> int:
        return metrics.breach_events

    def set_reboot_events(self, metrics, value: int) -> None:
        metrics.reboot_events = value

    def get_reboot_events(self, metrics) -> int:
        return metrics.reboot_events

    def set_mode_switches(self, metrics, value: int) -> None:
        raise NotImplementedError

    def get_mode_switches(self, metrics) -> int:
        raise NotImplementedError

    def set_decision_cost(self, metrics, value: float) -> None:
        raise NotImplementedError

    def get_decision_cost(self, metrics) -> float:
        raise NotImplementedError

    def validate_conservation(self, threat: float, absorbed: float, residual: float,
                              heat_loss: float, breach_penalty: float) -> Dict[str, Any]:
        raise NotImplementedError

    def should_defense_repair(self, core) -> bool:
        raise NotImplementedError

    @property
    def SystemState(self):
        return self.mod.SystemState

    @property
    def ShieldMode(self):
        return self.mod.ShieldMode

    @property
    def RebootMode(self):
        return self.mod.RebootMode

    @property
    def EventType(self):
        return self.mod.EventType

    @property
    def EventTier(self):
        return self.mod.EventTier

    @property
    def EventLog(self):
        return self.mod.EventLog

    @property
    def SimulationConfig(self):
        return self.mod.SimulationConfig

    def event_type_name(self, event_type) -> str:
        return event_type.name if hasattr(event_type, 'name') else str(event_type)


