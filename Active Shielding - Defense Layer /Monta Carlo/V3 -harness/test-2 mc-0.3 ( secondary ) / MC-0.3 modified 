@dataclass(frozen=True)
class ExperimentConfig:
    """[EXPERIMENT LAYER] Immutable experiment parameters."""
    runs: int = 50
    base_seed: int = 42
    max_ticks: int = 50
    verbose: bool = False
    output_file: Optional[str] = None
