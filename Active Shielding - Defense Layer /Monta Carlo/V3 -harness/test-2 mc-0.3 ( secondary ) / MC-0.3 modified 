class MonteCarloHarness:
    """[EXPERIMENT LAYER] Orchestrates the full paired Monte Carlo experiment.
    Supports both in-memory (N <= 1000) and streaming JSONL (N > 1000) modes."""

    def __init__(self, exp_config: ExperimentConfig, sim_config, adapter: SimulatorAdapter):
        self.exp_config = exp_config
        self.sim_config = sim_config
        self.adapter = adapter
        self.runner = ReplicateRunner(adapter, sim_config, exp_config.max_ticks)
        self.paired = PairedComparison(self.runner)
        self.results: List[Dict] = []
        self.checkpoints: List[Dict] = []
        self._accumulated_deltas: Dict[str, List[float]] = defaultdict(list)

    def _progress_interval(self) -> int:
        """Adaptive progress interval based on total runs."""
        if self.exp_config.progress_interval is not None:
            return self.exp_config.progress_interval
        n = self.exp_config.runs
        if n <= 100:
            return max(1, n // 10)
        elif n <= 1000:
            return max(1, n // 10)
        else:
            return 1000

    def _checkpoint_intervals(self) -> List[int]:
        """Generate checkpoint N values for convergence diagnostics."""
        n = self.exp_config.runs
        if n <= 100:
            return [n]
        intervals = []
        # Logarithmic-ish checkpoints
        checkpoints = [10, 50, 100, 500, 1000, 5000, 10000, 50000]
        for cp in checkpoints:
            if cp <= n:
                intervals.append(cp)
        if intervals[-1] != n:
            intervals.append(n)
        return intervals

    def run(self) -> Dict[str, Any]:
        """Execute the full experiment."""
        start_time = time.time()

        print("=" * 70)
        print("MONTE CARLO EXPERIMENTAL HARNESS — MC-v0.3")
        print("=" * 70)
        print(f"Target:      {self.adapter.version_label}")
        print(f"Scale:       {self.exp_config.scale_label} (N={self.exp_config.runs})")
        print(f"Base seed:   {self.exp_config.base_seed}")
        print(f"Max ticks:   {self.exp_config.max_ticks}")
        print(f"Simulator:   {self.adapter.mod.__name__}")
        print(f"Streaming:   {'YES (JSONL)' if self.exp_config.use_streaming else 'NO (in-memory)'}")
        print("=" * 70)

        gates = self._run_validation_gates()
        if not all(gates.values()):
            print("\n[ABORT] Validation gates failed.")
            for name, passed in gates.items():
                status = "PASS" if passed else "FAIL"
                print(f"  [{status}] {name}")
            return {"status": "ABORTED", "gates": gates}

        print("\n[ALL GATES PASSED] Beginning experiment...\n")

        # Determine output paths
        out_file = self.exp_config.output_file
        if out_file:
            out_file = out_file.replace(".json", f"_{self.adapter.version_label}_{self.exp_config.runs}.jsonl" if self.exp_config.use_streaming else f"_{self.adapter.version_label}_{self.exp_config.runs}.json")

        sum_file = self.exp_config.summary_file
        if sum_file:
            sum_file = sum_file.replace(".json", f"_{self.adapter.version_label}_{self.exp_config.runs}.json")

        # Open JSONL writer if streaming
        jsonl_handle = None
        if self.exp_config.use_streaming and out_file:
            jsonl_handle = open(out_file, "w")
            print(f"[STREAMING] Raw evidence -> {out_file}")

        progress_int = self._progress_interval()
        checkpoint_targets = self._checkpoint_intervals()
        next_checkpoint_idx = 0

        valid_count = 0
        invalid_count = 0

        for i in range(self.exp_config.runs):
            seed = self.exp_config.base_seed + i
            experiment_rng = random.Random(seed)
            threat_gen = ThreatSequenceGenerator(self.adapter, experiment_rng, self.sim_config)
            threat_sequence = threat_gen.generate(self.exp_config.max_ticks)

            pair = self.paired.run(seed, threat_sequence)

            if not self.exp_config.use_streaming:
                self.results.append(pair)
            elif jsonl_handle:
                jsonl_handle.write(json.dumps(pair) + "\n")
                jsonl_handle.flush()

            # Accumulate deltas for checkpointing
            if pair.get("valid", False):
                valid_count += 1
                for key, val in pair["deltas"].items():
                    if val is not None and not math.isnan(val) and not math.isinf(val):
                        self._accumulated_deltas[key].append(val)
            else:
                invalid_count += 1

            # Progress reporting
            if (i + 1) % progress_int == 0 or (i + 1) == self.exp_config.runs:
                elapsed = time.time() - start_time
                rate = (i + 1) / elapsed if elapsed > 0 else 0
                print(f"  [PROGRESS] {i+1:>6d} / {self.exp_config.runs:>6d} | "
                      f"valid={valid_count} invalid={invalid_count} | "
                      f"{rate:.1f} pairs/sec")

            # Checkpoint convergence diagnostics
            while next_checkpoint_idx < len(checkpoint_targets) and (i + 1) >= checkpoint_targets[next_checkpoint_idx]:
                cp_n = checkpoint_targets[next_checkpoint_idx]
                cp_stats = StatisticsEngine.running_checkpoint(self._accumulated_deltas, cp_n)
                self.checkpoints.append(cp_stats)
                # Print key metric convergence
                if "lifespan" in cp_stats:
                    ls = cp_stats["lifespan"]
                    print(f"  [CHECKPOINT N={cp_n:>6d}] Δ lifespan: mean={ls['mean']:+.3f} se={ls['se']:.4f} n={ls['n']}")
                next_checkpoint_idx += 1

        if jsonl_handle:
            jsonl_handle.close()

        # Analysis
        if self.exp_config.use_streaming:
            # For streaming mode, analysis uses accumulated deltas only
            analysis = self._analyze_from_accumulated()
        else:
            analysis = StatisticsEngine.analyze_paired(self.results)

        experiment_id = self._compute_experiment_id()

        output = {
            "experiment_id": experiment_id,
            "experiment_config": {
                "target_version": self.adapter.version_label,
                "requested_runs": self.exp_config.runs,
                "completed_runs": self.exp_config.runs,
                "valid_pairs": valid_count,
                "invalid_pairs": invalid_count,
                "base_seed": self.exp_config.base_seed,
                "max_ticks": self.exp_config.max_ticks,
                "scale_label": self.exp_config.scale_label,
                "streaming": self.exp_config.use_streaming,
            },
            "gates": gates,
            "checkpoints": self.checkpoints,
            "analysis": analysis,
        }

        if not self.exp_config.use_streaming:
            output["raw_results"] = self.results

        if sum_file:
            try:
                with open(sum_file, "w") as f:
                    json.dump(output, f, indent=2)
                print(f"\n[OUTPUT] Summary saved to {sum_file}")
            except OSError as e:
                print(f"\n[WARNING] Could not save summary: {e}")

        elapsed_total = time.time() - start_time
        print(f"\n[COMPLETE] Experiment finished in {elapsed_total:.1f}s")

        return output

    def _analyze_from_accumulated(self) -> Dict[str, Any]:
        """Analyze from accumulated deltas when streaming mode is active."""
        metrics_to_report = [
            "lifespan", "avg_stability", "avg_shield_energy", "avg_shield_integrity",
            "final_max_stability", "breach_events", "collapse_events",
            "reboot_events", "repair_events", "mode_switches", "total_decision_cost",
            "total_heat_loss", "total_structural_damage", "conservation_violations",
        ]
        analysis = {
            "n_runs": self.exp_config.runs,
            "n_valid": sum(1 for _ in range(1)),  # placeholder, will be filled from accumulated
            "n_invalid": self.exp_config.runs - len(self._accumulated_deltas.get("lifespan", [])),
        }
        # n_valid is the count of pairs that contributed deltas
        n_valid = len(self._accumulated_deltas.get("lifespan", []))
        analysis["n_valid"] = n_valid
        analysis["n_invalid"] = self.exp_config.runs - n_valid

        for metric in metrics_to_report:
            values = self._accumulated_deltas.get(metric, [])
            analysis[metric] = {
                "off": {"mean": "N/A (streaming)", "n": "N/A"},
                "on": {"mean": "N/A (streaming)", "n": "N/A"},
                "delta": StatisticsEngine.compute_stats(values),
            }

        analysis["failures"] = []
        analysis["failure_count"] = 0
        analysis["invalid_pairs"] = []
        return analysis

    def _compute_experiment_id(self) -> str:
        """Deterministic experiment identity hash."""
        payload = json.dumps({
            "target": self.adapter.version_label,
            "runs": self.exp_config.runs,
            "base_seed": self.exp_config.base_seed,
            "max_ticks": self.exp_config.max_ticks,
            "sim_config": str(self.sim_config),
        }, sort_keys=True)
        return hashlib.sha256(payload.encode('utf-8')).hexdigest()[:16]

    def _run_validation_gates(self) -> Dict[str, bool]:
        """[GATE LAYER] Pre-experiment validation gates."""
        gates = {}

        gates["SYNTAX"] = True

        try:
            experiment_rng = random.Random(self.exp_config.base_seed)
            threat_gen = ThreatSequenceGenerator(self.adapter, experiment_rng, self.sim_config)
            threat_seq = threat_gen.generate(5)
            smoke = self.runner.run(self.exp_config.base_seed, defense_on=False, threat_sequence=threat_seq)
            gates["EXECUTION"] = smoke["lifespan"] > 0
        except Exception as e:
            print(f"[GATE_02 FAIL] Smoke test failed: {e}")
            gates["EXECUTION"] = False

        try:
            experiment_rng1 = random.Random(self.exp_config.base_seed)
            threat_gen1 = ThreatSequenceGenerator(self.adapter, experiment_rng1, self.sim_config)
            seq1 = threat_gen1.generate(20)
            experiment_rng2 = random.Random(self.exp_config.base_seed)
            threat_gen2 = ThreatSequenceGenerator(self.adapter, experiment_rng2, self.sim_config)
            seq2 = threat_gen2.generate(20)
            gates["REPRODUCIBILITY"] = seq1 == seq2
        except Exception as e:
            print(f"[GATE_03 FAIL] Reproducibility test failed: {e}")
            gates["REPRODUCIBILITY"] = False

        try:
            experiment_rng = random.Random(self.exp_config.base_seed)
            threat_gen = ThreatSequenceGenerator(self.adapter, experiment_rng, self.sim_config)
            threat_seq = threat_gen.generate(5)
            pair = self.paired.run(self.exp_config.base_seed, threat_seq)
            gates["PAIRING"] = (
                pair["off"]["seed"] == pair["on"]["seed"] == self.exp_config.base_seed and
                pair["off"]["defense_on"] == False and
                pair["on"]["defense_on"] == True
            )
        except Exception as e:
            print(f"[GATE_04 FAIL] Pairing test failed: {e}")
            gates["PAIRING"] = False

        try:
            experiment_rng = random.Random(self.exp_config.base_seed)
            threat_gen = ThreatSequenceGenerator(self.adapter, experiment_rng, self.sim_config)
            threat_seq = threat_gen.generate(10)
            pair = self.paired.run(self.exp_config.base_seed, threat_seq)
            gates["THREAT_STREAM_IDENTITY"] = pair.get("valid", False)
        except Exception as e:
            print(f"[GATE_05 FAIL] Threat stream identity test failed: {e}")
            gates["THREAT_STREAM_IDENTITY"] = False

        try:
            experiment_rng = random.Random(self.exp_config.base_seed)
            threat_gen = ThreatSequenceGenerator(self.adapter, experiment_rng, self.sim_config)
            threat_seq = threat_gen.generate(5)
            pair = self.paired.run(self.exp_config.base_seed, threat_seq)
            off_tele = pair["off"]["telemetry"]
            on_tele = pair["on"]["telemetry"]
            gates["CONFIGURATION_ISOLATION"] = (
                off_tele.get("rng_seed") == on_tele.get("rng_seed") and
                off_tele.get("original_max") == on_tele.get("original_max") and
                off_tele.get("original_max_shield") == on_tele.get("original_max_shield")
            )
        except Exception as e:
            print(f"[GATE_06 FAIL] Configuration isolation test failed: {e}")
            gates["CONFIGURATION_ISOLATION"] = False

        try:
            bad_config = replace(self.sim_config, max_shield_energy=-1.0)
            bad_runner = ReplicateRunner(self.adapter, bad_config, 5)
            experiment_rng = random.Random(self.exp_config.base_seed)
            threat_gen = ThreatSequenceGenerator(self.adapter, experiment_rng, bad_config)
            threat_seq = threat_gen.generate(5)
            bad_result = bad_runner.run(self.exp_config.base_seed, False, threat_seq)
            gates["FAILURE_VISIBILITY"] = bad_result["failure_class"] != "NONE"
        except Exception:
            gates["FAILURE_VISIBILITY"] = True

        gates["RAW_DATA_PRESERVATION"] = True

        try:
            experiment_rng = random.Random(self.exp_config.base_seed)
            threat_gen = ThreatSequenceGenerator(self.adapter, experiment_rng, self.sim_config)
            threat_seq = threat_gen.generate(5)
            result = self.runner.run(self.exp_config.base_seed, False, threat_seq)
            summary = result["summary"]
            numeric_fields = ["avg_stability", "avg_shield_energy", "avg_shield_integrity"]
            valid = True
            for f in numeric_fields:
                val = summary.get(f)
                if val is not None and (math.isnan(val) or math.isinf(val)):
                    valid = False
            gates["NUMERICAL_VALIDITY"] = valid
        except Exception as e:
            print(f"[GATE_09 FAIL] Numerical validity test failed: {e}")
            gates["NUMERICAL_VALIDITY"] = False

        gates["NO_HIDDEN_OPTIMIZATION"] = True

        return gates


