# ==============================================================================

class PairedComparison:
    """[EXPERIMENT LAYER] One paired OFF/ON replicate with same threat sequence."""

    def __init__(self, runner: ReplicateRunner):
        self.runner = runner

    def run(self, seed: int, threat_sequence: List[float]) -> Dict[str, Any]:
        """Run OFF then ON with identical threat sequence."""
        off_result = self.runner.run(seed, defense_on=False, threat_sequence=threat_sequence)
        on_result = self.runner.run(seed, defense_on=True, threat_sequence=threat_sequence)

        threat_hash = ThreatSequenceGenerator.hash_sequence(threat_sequence)

        deltas = {}
        numeric_keys = [
            "lifespan", "avg_stability", "avg_shield_energy", "avg_shield_integrity",
            "final_max_stability", "collapse_events", "breach_events",
            "reboot_events", "repair_events", "mode_switches", "total_decision_cost",
            "total_heat_loss", "total_structural_damage", "conservation_violations",
        ]

        for key in numeric_keys:
            off_val = off_result["summary"].get(key)
            on_val = on_result["summary"].get(key)
            if off_val is None or on_val is None:
                deltas[key] = None
            elif isinstance(off_val, (int, float)) and isinstance(on_val, (int, float)):
                if math.isnan(off_val) or math.isnan(on_val) or math.isinf(off_val) or math.isinf(on_val):
                    deltas[key] = None
                else:
                    deltas[key] = round(on_val - off_val, 4)
            else:
                deltas[key] = None

        valid, invalid_reasons = self._assess_validity(off_result, on_result)

        return {
            "seed": seed,
            "threat_sequence_hash": threat_hash,
            "off": off_result,
            "on": on_result,
            "deltas": deltas,
            "paired": True,
            "valid": valid,
            "invalid_reasons": invalid_reasons,
        }

    def _assess_validity(self, off: Dict, on: Dict) -> Tuple[bool, List[str]]:
        """Determine whether this paired replicate satisfies experimental invariants."""
        reasons = []

        if off["failure_class"] != "NONE":
            reasons.append(f"OFF failed: {off['failure_class']} — {off['failure_detail']}")
        if on["failure_class"] != "NONE":
            reasons.append(f"ON failed: {on['failure_class']} — {on['failure_detail']}")

        off_tele = off["telemetry"]
        on_tele = on["telemetry"]
        if off_tele.get("rng_seed") != on_tele.get("rng_seed"):
            reasons.append("Configuration isolation violated: rng_seed differs")
        if off_tele.get("original_max") != on_tele.get("original_max"):
            reasons.append("Configuration isolation violated: original_max differs")
        if off_tele.get("original_max_shield") != on_tele.get("original_max_shield"):
            reasons.append("Configuration isolation violated: original_max_shield differs")

        if not off["summary"] or not on["summary"]:
            reasons.append("Evidence recording failure: empty summary")

        valid = len(reasons) == 0
        return valid, reasons


