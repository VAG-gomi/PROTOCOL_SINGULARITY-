# SECTION 6: THREAT SEQUENCE GENERATOR
# ==============================================================================

class ThreatSequenceGenerator:
    """[EXPERIMENT LAYER] Generates immutable threat sequences using an
    experiment-scoped RNG independent of simulator RNG consumption."""

    def __init__(self, adapter: SimulatorAdapter, rng: random.Random, config):
        self.adapter = adapter
        self._rng = rng
        self.config = config

    def generate(self, max_ticks: int) -> List[float]:
        """Generate a complete threat sequence deterministically."""
        gen = self.adapter.create_threat_generator(self._rng, self.config)
        return [gen.next() for _ in range(max_ticks)]

    @staticmethod
    def hash_sequence(sequence: List[float]) -> str:
        """Compute deterministic hash of threat sequence for identity verification."""
        payload = json.dumps(sequence, separators=(',', ':'))
        return hashlib.sha256(payload.encode('utf-8')).hexdigest()[:16]


# ==============================================================================
# SECTION 7: SINGLE REPLICATE RUNNER
# ==============================================================================

class ReplicateRunner:
    """[EXPERIMENT LAYER] Runs a single replicate under one condition
    with an externally supplied threat sequence, using the adapter."""

    def __init__(self, adapter: SimulatorAdapter, sim_config, max_ticks: int):
        self.adapter = adapter
        self.sim_config = sim_config
        self.max_ticks = max_ticks

    def run(self, seed: int, defense_on: bool, threat_sequence: List[float]) -> Dict[str, Any]:
        """Run one replicate. Returns raw evidence, not interpretation."""
        config = replace(self.sim_config, rng_seed=seed)
        core = self.adapter.create_core(config, defense_on)

        metrics = self.adapter.create_metrics_collector()
        failure_class = FailureClass.NONE
        failure_detail = ""
        final_tick = 0
        ticks_processed = 0

        EventType = self.adapter.EventType

        for tick, threat in enumerate(threat_sequence, 1):
            core.tick = tick
            ticks_processed += 1

            try:
                result = self.adapter.inject_threat(core, threat)
            except Exception as e:
                failure_class = FailureClass.SIMULATION_ERROR
                failure_detail = f"inject_threat failed at T+{tick}: {e}"
                final_tick = tick
                break

            self.adapter.record_metrics(
                metrics, tick,
                self.adapter.get_core_state(core),
                core.stability, core.shield_energy, core.shield_integrity,
                core.max_stability
            )

            if result.get("event") == EventType.SHIELD_BREACH:
                self.adapter.set_breach_events(
                    metrics, self.adapter.get_breach_events(metrics) + 1
                )

            defense = self.adapter.get_core_defense(core)
            if defense:
                self.adapter.set_mode_switches(metrics, defense.mode_switches)
                self.adapter.set_decision_cost(metrics, defense.total_decision_cost)

            if "shield_result" in result:
                sr = result["shield_result"]
                breach_penalty = result["threat"] * config.breach_penalty_pct if sr.get("breach") else 0.0
                conservation = self.adapter.validate_conservation(
                    result["threat"], sr["absorbed"], sr["residual"],
                    sr.get("heat_loss", 0.0), breach_penalty
                )
                self.adapter.record_conservation(
                    metrics,
                    sr.get("heat_loss", 0.0),
                    sr.get("structural_damage", 0.0),
                    conservation
                )

            if self.adapter.get_core_state(core) == self.adapter.SystemState.COLLAPSED:
                try:
                    reb = self.adapter.manual_reboot(core)
                except Exception as e:
                    failure_class = FailureClass.SIMULATION_ERROR
                    failure_detail = f"manual_reboot failed at T+{tick}: {e}"
                    final_tick = tick
                    break

                reboot_exhausted = self.adapter.event_type_name(reb.get("event", "")) == "REBOOT_EXHAUSTED"
                if reboot_exhausted:
                    final_tick = tick
                    break
                self.adapter.set_reboot_events(
                    metrics, self.adapter.get_reboot_events(metrics) + 1
                )
            else:
                try:
                    self.adapter.auto_recovery(core)
                    if self.adapter.should_defense_repair(core):
                        rep = self.adapter.structural_repair(core)
                    else:
                        rep = self.adapter.structural_repair(core)
                    srep = self.adapter.shield_structural_repair(core)
                except Exception as e:
                    failure_class = FailureClass.SIMULATION_ERROR
                    failure_detail = f"recovery/repair failed at T+{tick}: {e}"
                    final_tick = tick
                    break

                if rep.get("event") and self.adapter.event_type_name(rep["event"]) == "REPAIR_SUCCESS":
                    metrics.repair_events += 1
                if srep.get("event") and self.adapter.event_type_name(srep["event"]) == "SHIELD_REPAIR_SUCCESS":
                    metrics.repair_events += 1

            try:
                self.adapter.validate_core(core)
            except ValueError as e:
                failure_class = FailureClass.NUMERICAL_ERROR
                failure_detail = f"Invariant violation at T+{tick}: {e}"
                final_tick = tick
                break

            final_tick = tick

        summary = self.adapter.get_metrics_summary(metrics)

        return {
            "seed": seed,
            "condition": "ON" if defense_on else "OFF",
            "defense_on": defense_on,
            "lifespan": final_tick,
            "ticks_processed": ticks_processed,
            "failure_class": failure_class.name,
            "failure_detail": failure_detail,
            "summary": summary,
            "telemetry": self.adapter.get_core_telemetry(core),
            "event_count": len(self.adapter.get_core_events(core)),
        }


