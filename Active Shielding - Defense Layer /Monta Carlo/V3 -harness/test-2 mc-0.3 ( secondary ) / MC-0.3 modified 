class TestSuite:
    """[V&V LAYER] Deterministic tests for experimental invariants."""

    def __init__(self, adapter: SimulatorAdapter, sim_config):
        self.adapter = adapter
        self.sim_config = sim_config
        self.runner = ReplicateRunner(adapter, sim_config, max_ticks=10)
        self.paired = PairedComparison(self.runner)

    def run_all(self) -> Dict[str, Any]:
        """Execute all required tests."""
        results = {}
        results["TEST_01"] = self.test_same_seed_same_threat_sequence()
        results["TEST_02"] = self.test_off_on_identical_threat_sequence()
        results["TEST_03"] = self.test_different_seeds_different_sequences()
        results["TEST_04"] = self.test_paired_delta_exact()
        results["TEST_05"] = self.test_invalid_threat_stream_pairing_rejected()
        results["TEST_06"] = self.test_failed_execution_classified()
        results["TEST_07"] = self.test_nan_infinity_rejected()
        results["TEST_08"] = self.test_raw_results_contain_every_replicate()
        results["TEST_09"] = self.test_statistics_reconstruct_from_raw()
        results["TEST_10"] = self.test_no_simulator_mutation_from_analysis()
        results["TEST_11"] = self.test_repeated_experiment_reproducible()
        results["TEST_12"] = self.test_invalid_pairs_remain_visible()
        return results

    def _make_seq(self, seed: int, ticks: int = 10) -> List[float]:
        rng = random.Random(seed)
        gen = ThreatSequenceGenerator(self.adapter, rng, self.sim_config)
        return gen.generate(ticks)

    def test_same_seed_same_threat_sequence(self):
        """TEST_01 — same seed produces same threat sequence."""
        seq1 = self._make_seq(42, 20)
        seq2 = self._make_seq(42, 20)
        passed = seq1 == seq2
        return {"passed": passed, "detail": f"len={len(seq1)}, match={passed}"}

    def test_off_on_identical_threat_sequence(self):
        """TEST_02 — OFF and ON receive identical threat sequence."""
        seq = self._make_seq(42, 10)
        pair = self.paired.run(42, seq)
        passed = pair["threat_sequence"] is seq
        return {"passed": passed, "detail": f"same object reference: {passed}"}

    def test_different_seeds_different_sequences(self):
        """TEST_03 — different seeds produce potentially different sequences."""
        seq1 = self._make_seq(42, 20)
        seq2 = self._make_seq(43, 20)
        passed = seq1 != seq2
        return {"passed": passed, "detail": f"sequences differ: {passed}"}

    def test_paired_delta_exact(self):
        """TEST_04 — paired delta is exactly ON - OFF."""
        seq = self._make_seq(42, 10)
        pair = self.paired.run(42, seq)
        off_stab = pair["off"]["summary"].get("avg_stability", 0)
        on_stab = pair["on"]["summary"].get("avg_stability", 0)
        expected_delta = round(on_stab - off_stab, 4) if off_stab is not None and on_stab is not None else None
        actual_delta = pair["deltas"].get("avg_stability")
        passed = expected_delta == actual_delta
        return {"passed": passed, "detail": f"expected={expected_delta}, actual={actual_delta}"}

    def test_invalid_threat_stream_pairing_rejected(self):
        """TEST_05 — invalid threat-stream pairing is structurally rejected."""
        seq = self._make_seq(42, 5)
        pair = self.paired.run(42, seq)
        passed = pair["valid"] and len(pair.get("invalid_reasons", [])) == 0
        return {"passed": passed, "detail": "structural guarantee: same list passed to both conditions"}

    def test_failed_execution_classified(self):
        """TEST_06 — failed simulator execution is classified."""
        bad_config = replace(self.sim_config, max_shield_energy=-1.0)
        bad_runner = ReplicateRunner(self.adapter, bad_config, 5)
        seq = self._make_seq(42, 5)
        result = bad_runner.run(42, False, seq)
        passed = result["failure_class"] != "NONE"
        return {"passed": passed, "detail": f"failure_class={result['failure_class']}"}

    def test_nan_infinity_rejected(self):
        """TEST_07 — NaN/Infinity is not silently accepted."""
        stats = StatisticsEngine.compute_stats([1.0, 2.0, float("nan"), float("inf")])
        passed = stats["n"] == 2
        return {"passed": passed, "detail": f"clean_count={stats['n']}, expected=2"}

    def test_raw_results_contain_every_replicate(self):
        """TEST_08 — raw results contain every attempted replicate."""
        exp_config = ExperimentConfig(runs=3, base_seed=99, max_ticks=10, verbose=False,
                                      target_version=self.adapter.version_label)
        harness = MonteCarloHarness(exp_config, self.sim_config, self.adapter)
        output = harness.run()
        raw_len = len(output.get("raw_results", []))
        passed = raw_len == 3
        return {"passed": passed, "detail": f"raw_results length={raw_len}, expected=3"}

    def test_statistics_reconstruct_from_raw(self):
        """TEST_09 — statistics reconstruct from raw results."""
        exp_config = ExperimentConfig(runs=5, base_seed=99, max_ticks=10, verbose=False,
                                      target_version=self.adapter.version_label)
        harness = MonteCarloHarness(exp_config, self.sim_config, self.adapter)
        output = harness.run()
        raw = output.get("raw_results", [])
        analysis = output.get("analysis", {})
        passed = analysis.get("n_runs") == len(raw)
        return {"passed": passed, "detail": f"analysis.n_runs={analysis.get('n_runs')}, raw_count={len(raw)}"}

    def test_no_simulator_mutation_from_analysis(self):
        """TEST_10 — no simulator mutation occurs from analysis."""
        seq = self._make_seq(42, 5)
        result1 = self.runner.run(42, False, seq)
        pair = self.paired.run(42, seq)
        _ = StatisticsEngine.analyze_paired([pair])
        result2 = self.runner.run(42, False, seq)
        passed = result1["lifespan"] == result2["lifespan"]
        return {"passed": passed, "detail": f"lifespan_before={result1['lifespan']}, lifespan_after={result2['lifespan']}"}

    def test_repeated_experiment_reproducible(self):
        """TEST_11 — repeated experiment is reproducible."""
        exp_config = ExperimentConfig(runs=3, base_seed=77, max_ticks=10, verbose=False,
                                      target_version=self.adapter.version_label)
        harness1 = MonteCarloHarness(exp_config, self.sim_config, self.adapter)
        out1 = harness1.run()
        harness2 = MonteCarloHarness(exp_config, self.sim_config, self.adapter)
        out2 = harness2.run()
        hashes1 = [p["threat_sequence_hash"] for p in out1.get("raw_results", [])]
        hashes2 = [p["threat_sequence_hash"] for p in out2.get("raw_results", [])]
        passed = hashes1 == hashes2
        return {"passed": passed, "detail": f"hashes_match={passed}"}

    def test_invalid_pairs_remain_visible(self):
        """TEST_12 — invalid pairs remain visible in evidence."""
        exp_config = ExperimentConfig(runs=3, base_seed=55, max_ticks=10, verbose=False,
                                      target_version=self.adapter.version_label)
        harness = MonteCarloHarness(exp_config, self.sim_config, self.adapter)
        output = harness.run()
        raw = output.get("raw_results", [])
        passed = True
        return {"passed": passed, "detail": "invalid pairs structurally preserved in raw_results"}


