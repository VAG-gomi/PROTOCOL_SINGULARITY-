    def create_metrics_collector(self):
        return self.mod.MetricsCollector()

    def record_conservation(self, metrics, heat, structural, conservation_result):
        # v3.6: record_conservation(heat, structural, violation)
        metrics.record_conservation(heat, structural, conservation_result["violation"])

    def set_mode_switches(self, metrics, value):
        metrics.mode_switches = value

    def get_mode_switches(self, metrics):
        return getattr(metrics, 'mode_switches', 0)

    def set_decision_cost(self, metrics, value):
        metrics.total_decision_cost = value

    def get_decision_cost(self, metrics):
        return getattr(metrics, 'total_decision_cost', 0.0)

    def validate_conservation(self, threat, absorbed, residual, heat_loss, breach_penalty):
        return self.mod.ConservationEnforcer.validate(
            threat, absorbed, residual, heat_loss, breach_penalty
        )

    def should_defense_repair(self, core):
        if core.defense:
            return core.defense.should_repair(
                core.shield_integrity, core.shield_energy, core.max_shield_energy
            )
        return False


