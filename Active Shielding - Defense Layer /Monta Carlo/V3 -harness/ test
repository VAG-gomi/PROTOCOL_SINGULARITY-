        "adapter_class": V36Adapter,
    },
}


def load_target(version_label: str) -> SimulatorAdapter:
    """Load simulator module and return the appropriate adapter.

    Tries importlib.import_module first (for installed packages),
    then falls back to loading from file in the same directory.
    """
    if version_label not in TARGET_REGISTRY:
        available = ", ".join(TARGET_REGISTRY.keys())
        raise ValueError(f"Unknown target '{version_label}'. Available: {available}")

    entry = TARGET_REGISTRY[version_label]
    module_name = entry["module_name"]
    adapter_class = entry["adapter_class"]

    # Try standard import first
    try:
        mod = importlib.import_module(module_name)
        print(f"[LOADER] Loaded {module_name} via importlib")
        return adapter_class(mod)
    except ImportError:
        pass

    # Fall back to loading from file in same directory
    script_dir = os.path.dirname(os.path.abspath(__file__)) if __file__ else os.getcwd()
    file_path = os.path.join(script_dir, entry["file_hint"])

    if not os.path.exists(file_path):
        # Try current working directory
        file_path = os.path.join(os.getcwd(), entry["file_hint"])

    if not os.path.exists(file_path):
        raise FileNotFoundError(
            f"Cannot find simulator file for {version_label}. "
            f"Tried module '{module_name}' and file '{entry['file_hint']}'. "
            f"Ensure the simulator file is in the same directory as mc_v03.py."
        )

    spec = importlib.util.spec_from_file_location(module_name, file_path)
    mod = importlib.util.module_from_spec(spec)
    sys.modules[module_name] = mod
    spec.loader.exec_module(mod)
    print(f"[LOADER] Loaded {module_name} from {file_path}")
    return adapter_class(mod)


