# SECTION 9: STATISTICS ENGINE
# ==============================================================================

class StatisticsEngine:
    """[ANALYSIS LAYER] Computes aggregate statistics from replicate results.
    Never manufactures invalid statistics."""

    @staticmethod
    def compute_stats(values: List[float]) -> Dict[str, Any]:
        """Compute mean, median, stdev, min, max, n. Rejects NaN/Inf."""
        if not values:
            return {"mean": 0.0, "median": 0.0, "stdev": 0.0, "min": 0.0, "max": 0.0, "n": 0}

        clean = []
        for v in values:
            if v is None:
                continue
            if isinstance(v, (int, float)):
                if math.isnan(v) or math.isinf(v):
                    continue
                clean.append(float(v))

        if not clean:
            return {"mean": float("nan"), "median": float("nan"), "stdev": float("nan"),
                    "min": float("nan"), "max": float("nan"), "n": 0}

        return {
            "mean": round(statistics.mean(clean), 4),
            "median": round(statistics.median(clean), 4),
            "stdev": round(statistics.stdev(clean), 4) if len(clean) > 1 else 0.0,
            "min": round(min(clean), 4),
            "max": round(max(clean), 4),
            "n": len(clean),
        }

    @classmethod
    def analyze_paired(cls, paired_results: List[Dict]) -> Dict[str, Any]:
        """Analyze all paired replicates. Preserves invalid pairs visibly."""
        valid_pairs = [p for p in paired_results if p.get("valid", False)]
        invalid_pairs = [p for p in paired_results if not p.get("valid", False)]

        def extract_metric(pairs, metric_key, condition):
            vals = []
            for p in pairs:
                val = p[condition]["summary"].get(metric_key)
                if val is not None and not math.isnan(val) and not math.isinf(val):
                    vals.append(val)
            return vals

        def extract_delta(pairs, metric_key):
            vals = []
            for p in pairs:
                val = p["deltas"].get(metric_key)
                if val is not None and not math.isnan(val) and not math.isinf(val):
                    vals.append(val)
            return vals

        metrics_to_report = [
            "lifespan", "avg_stability", "avg_shield_energy", "avg_shield_integrity",
            "final_max_stability", "breach_events", "collapse_events",
            "reboot_events", "repair_events", "mode_switches", "total_decision_cost",
            "total_heat_loss", "total_structural_damage", "conservation_violations",
        ]

        analysis = {
            "n_runs": len(paired_results),
            "n_valid": len(valid_pairs),
            "n_invalid": len(invalid_pairs),
        }

        for metric in metrics_to_report:
            analysis[metric] = {
                "off": cls.compute_stats(extract_metric(valid_pairs, metric, "off")),
                "on": cls.compute_stats(extract_metric(valid_pairs, metric, "on")),
                "delta": cls.compute_stats(extract_delta(valid_pairs, metric)),
            }

        failures = []
        for r in paired_results:
            for condition in ["off", "on"]:
                fc = r[condition].get("failure_class", "NONE")
                if fc != "NONE":
                    failures.append({
                        "seed": r["seed"],
                        "condition": condition,
                        "failure_class": fc,
                        "detail": r[condition].get("failure_detail", ""),
                    })

        invalid_reasons = []
        for p in invalid_pairs:
            invalid_reasons.append({
                "seed": p["seed"],
                "reasons": p.get("invalid_reasons", []),
            })

        analysis["failures"] = failures
        analysis["failure_count"] = len(failures)
        analysis["invalid_pairs"] = invalid_reasons

        return analysis


