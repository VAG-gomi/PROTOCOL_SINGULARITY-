class V35Adapter(SimulatorAdapter):
    """Adapter for PROTOCOL_SINGULARITY_v3.5 (COG-V&V)."""

    def __init__(self, module):
        super().__init__(module, "v3.5")

    def create_threat_generator(self, rng, config):
        return self.mod.ThreatGenerator(
            rng,
            config.threat_low,
            config.threat_high,
            config.threat_cooldown_ticks,
            config.threat_escalation_factor,
        )

    def create_core(self, config, defense_on: bool):
        core = self.mod.SingularityCoreV3(config)
        if not defense_on:
            core.set_shield_mode(self.mod.ShieldMode.BALANCED)
        return core

    def get_core_defense(self, core):
        return None  # v3.5 has no DefenseController

    def create_metrics_collector(self):
        return self.mod.MetricsCollector()

    def record_conservation(self, metrics, heat, structural, conservation_result):
        # v3.5: record_conservation(heat, structural, error)
        metrics.record_conservation(heat, structural, conservation_result["error"])

    def set_mode_switches(self, metrics, value):
        pass  # v3.5 has no mode_switches attribute

    def get_mode_switches(self, metrics):
        return 0

    def set_decision_cost(self, metrics, value):
        pass  # v3.5 has no total_decision_cost attribute

    def get_decision_cost(self, metrics):
        return 0.0

    def validate_conservation(self, threat, absorbed, residual, heat_loss, breach_penalty):
        # v3.5 has no ConservationEnforcer class; compute manually
        total = absorbed + residual + heat_loss
        expected = threat + breach_penalty
        error = abs(total - expected)
        return {
            "valid": error <= 0.001,
            "total": total,
            "expected": expected,
            "error": error,
            "violation": error > 0.001,
        }

    def should_defense_repair(self, core):
        return False  # v3.5 has no defense-controlled repair


