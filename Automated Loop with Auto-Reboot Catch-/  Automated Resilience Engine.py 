class ResilienceLoop:
    """
    Orchestrates an autonomous while-loop where each tick applies a random
    adversarial attack. If collapse occurs, an emergency hard-start is
    automatically triggered. The loop continues until all reboots are exhausted
    or the safety timeout is reached.
    """

    # [SINGULARITY_HEADER]
    # Intent  : Model an autonomous resilient system that self-heals between
    #           attacks and auto-reboots upon collapse, consuming a finite reboot
    #           budget with permanent capacity degradation, until terminal failure.
    # State   : Loop holds [AdversarialSystem, threat_range, recovery_rate,
    #           capacity_penalty_percent, max_ticks, tick_delay, current_tick,
    #           audit_log]; expects [execution trigger].
    # Action  : Validate config → initialize system → enter while loop → generate
    #           random threat → inject → if collapsed → auto-reboot → check
    #           post-reboot state → if still collapsed → break → else continue
    #           → if not collapsed → recovery → increment tick → delay → check
    #           max_ticks → return complete forensic record.

    def __init__(
        self,
        max_stability: float,
        collapse_threshold: float,
        threat_range: Tuple[float, float],
        recovery_rate: float,
        max_reboots: int = 2,
        capacity_penalty_percent: float = 20.0,
        max_ticks: int = 10000,
        tick_delay: float = 0.4,
        strain_ratio: float = 0.5,
        recovery_balance_threshold: float = 0.8,
    ):
        # [Entity: threat_range bounds]
        # --(validation: enforce well-ordered non-negative bounds)--> [State: threat bounds verified]
        min_threat, max_threat = threat_range
        if min_threat < 0 or max_threat < 0:
            raise ValueError("[COGNITION_GAP]: threat_range bounds must be non-negative.")
        if min_threat > max_threat:
            raise ValueError("[COGNITION_GAP]: threat_range must be well-ordered.")

        # [Entity: recovery_rate parameter]
        # --(validation: enforce non-negative restorative energy)--> [State: recovery rate verified]
        if recovery_rate < 0:
            raise ValueError("[COGNITION_GAP]: recovery_rate must be non-negative.")

        # [Entity: capacity_penalty_percent parameter]
        # --(validation: enforce meaningful percentage bounds)--> [State: penalty percentage verified]
        if not (0 <= capacity_penalty_percent <= 100):
            raise ValueError("[COGNITION_GAP]: capacity_penalty_percent must be in [0, 100].")

        # [Entity: max_reboots parameter]
        # --(validation: enforce non-negative hard-start budget)--> [State: reboot budget verified]
        if max_reboots < 0:
            raise ValueError("[COGNITION_GAP]: max_reboots must be non-negative.")

        # [Entity: max_ticks parameter]
        # --(validation: enforce at least one tick)--> [State: tick budget verified]
        if max_ticks < 1:
            raise ValueError("[COGNITION_GAP]: max_ticks must be >= 1.")

        # [Entity: tick_delay parameter]
        # --(validation: enforce non-negative latency)--> [State: delay verified cosmetic-only]
        if tick_delay < 0:
            tick_delay = 0.0

        # [Entity: validated design parameters and thresholds]
        # --(composition: instantiate formal adversarial substrate with reboot)--> [State: AdversarialSystem initialized]
        self.system = AdversarialSystem(
            max_stability=max_stability,
            collapse_threshold=collapse_threshold,
            max_reboots=max_reboots,
            strain_ratio=strain_ratio,
            recovery_balance_threshold=recovery_balance_threshold,
        )

        # [Entity: validated threat bounds]
        # --(assignment to instance)--> [State: stochastic sampling range configured]
        self.threat_min: float = float(min_threat)
        self.threat_max: float = float(max_threat)

        # [Entity: validated recovery_rate]
        # --(assignment to instance)--> [State: passive homeostatic energy configured]
        self.recovery_rate: float = float(recovery_rate)

        # [Entity: validated capacity_penalty_percent]
        # --(assignment to instance)--> [State: reboot penalty configured]
        self.capacity_penalty_percent: float = float(capacity_penalty_percent)

        # [Entity: validated max_ticks]
        # --(assignment to instance)--> [State: safety timeout configured]
        self.max_ticks: int = max_ticks

        # [Entity: validated tick_delay]
        # --(assignment to instance)--> [State: inter-tick latency configured]
        self.tick_delay: float = float(tick_delay)

        # [Entity: tick counter initialized to zero]
        # --(assignment to instance)--> [State: temporal index at origin]
        self.current_tick: int = 0

        # [Entity: empty list structure]
        # --(initialization: prepare ordered forensic container)--> [State: audit_log ready for capture]
        self.audit_log: List[str] = []

    def run(self) -> Tuple[List[str], str, float, float, int, int]:
        """
        Execute the autonomous resilience loop and return the complete audit
        trail, final state, final stability, final max_stability, reboot count,
        and total ticks.
        """
        # [Entity: simulation parameters and empty audit_log]
        # --(header generation: establish forensic trail origin)--> [State: audit_log initialized with session metadata]
        self.audit_log.append(
            "=========================================================="
        )
        self.audit_log.append(
            "AUTOMATED RESILIENCE & REBOOT ENGINE"
        )
        self.audit_log.append(
            f"Max Stability: {self.system.max_stability:.1f} | "
            f"Threshold: {self.system.threshold:.1f} | "
            f"Max Reboots: {self.system.max_reboots} | "
            f"Recovery: {self.recovery_rate:.1f}/tick"
        )
        self.audit_log.append(
            "=========================================================="
        )

        # [Entity: current_tick counter and max_ticks limit]
        # --(loop guard: enforce termination when safety budget exhausted)--> [State: while condition evaluated]
        while self.current_tick < self.max_ticks:
            # [Entity: current tick counter]
            # --(increment: advance temporal index for current iteration)--> [State: tick counter updated to next position]
            self.current_tick += 1

            # [Entity: tick identity]
            # --(log entry creation: document temporal boundary for forensic trace)--> [State: tick header appended to audit_log]
            self.audit_log.append(f"\n--- TIME TICK T+{self.current_tick} ---")

            # [Entity: Python random module and threat bounds]
            # --(stochastic sampling: model unpredictable adversarial intensity)--> [State: threat_force generated]
            threat_force = round(random.uniform(self.threat_min, self.threat_max), 1)

            # [Entity: threat identity and magnitude]
            # --(log entry creation: document incoming attack vector)--> [State: threat event logged]
            self.audit_log.append(
                f"[EVENT 1: THREAT]: Attack magnitude = {threat_force}"
            )

            # [Entity: AdversarialSystem instance and generated threat]
            # --(state transition execution: process adversarial event per formal protocol)--> [State: attack result produced and system state updated]
            threat_msg = self.system.inject_threat(threat_force)
            self.audit_log.append(f"   └── {threat_msg}")

            # [Entity: system state flag post-threat]
            # --(conditional evaluation: route to auto-reboot or recovery based on collapse status)--> [State: execution path selected]
            if self.system.system_state == "COLLAPSED":
                # [Entity: collapsed system]
                # --(alert generation: document critical event for forensic trace)--> [State: collapse alert logged]
                self.audit_log.append(
                    "🚨 [CRITICAL ALERT]: Collapse detected! "
                    "Triggering automated hard reboot..."
                )

                # [Entity: AdversarialSystem instance and configured penalty]
                # --(hard-start execution: process emergency reboot per formal protocol)--> [State: reboot result produced and system state updated]
                reboot_msg = self.system.manual_reboot(self.capacity_penalty_percent)
                self.audit_log.append(f"   └── {reboot_msg}")

                # [Entity: system state flag post-reboot]
                # --(terminal evaluation: detect if reboot failed or was denied)--> [State: termination condition assessed]
                if self.system.system_state == "COLLAPSED":
                    # [Entity: permanently collapsed system]
                    # --(loop break: enforce termination since no further reboots are possible)--> [State: loop exited, terminal failure recorded]
                    self.audit_log.append(
                        f"\n💀 [TERMINAL FAILURE]: All reboots exhausted. "
                        f"System permanently destroyed at Tick T+{self.current_tick}."
                    )
                    break

            # [Entity: system state flag (not collapsed)]
            # --(restorative path: system survived attack and requires homeostatic repair)--> [State: recovery execution selected]
            else:
                # [Entity: AdversarialSystem instance and configured recovery_rate]
                # --(restoration execution: process automatic homeostatic repair per formal protocol)--> [State: recovery result produced and system state updated]
                recovery_msg = self.system.auto_recovery_tick(self.recovery_rate)

                # [Entity: recovery event label and result narrative]
                # --(audit capture: preserve causal outcome in ordered record)--> [State: recovery event logged]
                self.audit_log.append("[EVENT 2: HEALING]: Auto-recovery tick active")
                self.audit_log.append(f"   └── {recovery_msg}")

            # [Entity: simulation clock and tick_delay parameter]
            # --(temporal suspension: simulate inter-tick latency for realistic pacing)--> [State: execution paused, preserving causal ordering between ticks]
            if self.tick_delay > 0:
                time.sleep(self.tick_delay)

        # [Entity: completed audit_log and final system metrics]
        # --(footer generation: summarize terminal condition for caller analysis)--> [State: audit_log finalized with session conclusion]
        self.audit_log.append(
            "\n=========================================================="
        )
        self.audit_log.append(
            f"SIMULATION TERMINATED | Total Lifespan: {self.current_tick} Ticks"
        )
        self.audit_log.append(
            f"Total Reboots Used: {self.system.reboot_count}/{self.system.max_reboots} | "
            f"Final Max Capacity: {self.system.max_stability:.1f} | "
            f"Final State: {self.system.system_state}"
        )
        self.audit_log.append(
            "=========================================================="
        )

        # [Entity: finalized audit_log and terminal metrics]
        # --(return to caller: deliver complete forensic record and terminal metrics)--> [State: caller receives immutable simulation outcome]
        return (
            self.audit_log,
            self.system.system_state,
            self.system.stability,
            self.system.max_stability,
            self.system.reboot_count,
            self.current_tick,
        )


